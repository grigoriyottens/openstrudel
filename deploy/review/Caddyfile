# Persistent review entry point. Keep this independently of Home image releases.
magic.mikwiseman.com {
  redir /openstrudel-review /openstrudel-review/ 308
  handle_path /openstrudel-review/* {
    header X-Robots-Tag "noindex, nofollow, noarchive"
    reverse_proxy openstrudel-review:8080
  }
  handle {
    respond 404
  }
  header {
    Strict-Transport-Security "max-age=31536000"
    X-Content-Type-Options "nosniff"
    Referrer-Policy "no-referrer"
    -Server
  }
}
